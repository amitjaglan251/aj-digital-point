rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /serviceRequests/{requestId} {
      // Customers must be signed in anonymously or otherwise authenticated.
      // Client writes are limited to creation; clients cannot change status.
      allow create: if request.auth != null
        && request.resource.data.requestId == requestId
        && request.resource.data.status == 'Payment Pending'
        && request.resource.data.keys().hasOnly([
          'requestId', 'service', 'name', 'mobile', 'email', 'status', 'createdAt'
        ]);

      // Do not expose the full customer request collection publicly.
      // Admin/server-side status management should use a trusted backend.
      allow read, update, delete: if false;
    }
  }
}
